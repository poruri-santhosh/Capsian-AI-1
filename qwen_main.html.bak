    <!-- ============================================================
         VIEW: LESSON
         ============================================================ -->
    <div class="view" id="view-lesson" style="background: var(--bg-dark); min-height: calc(100vh - 64px);">
      <div class="lesson-layout">
        <div class="lesson-main">
          <!-- Breadcrumb -->
          <nav class="breadcrumb" aria-label="Lesson navigation">
            <a href="#" onclick="navigateTo('dashboard'); return false;">JavaScript Basics</a>
            <span class="breadcrumb-sep" aria-hidden="true">›</span>
            <span style="color: var(--text-inverse);">Variables & Data Types</span>
            <span style="margin-left: auto; color: var(--text-muted);">6 / 12</span>
          </nav>

          <!-- Lesson Header -->
          <div style="margin-bottom: var(--sp-6);">
            <div style="display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-3); flex-wrap: wrap;">
              <span style="font-size: 0.75rem; font-weight: 600; color: var(--primary); background: rgba(99,102,241,0.15); padding: 3px 10px; border-radius: var(--r-full);">CONCEPT 01</span>
              <span style="font-size: 0.75rem; color: var(--text-inverse-secondary);">~8 min read</span>
            </div>
            <h1 style="font-size: 2rem; font-weight: 700; color: var(--text-inverse); letter-spacing: -0.02em; margin-bottom: var(--sp-3);">Variables</h1>
            <p style="font-size: 1rem; color: var(--text-inverse-secondary); line-height: 1.6; max-width: 640px;">
              Variables are containers for storing data values. You can think of them as labeled boxes that hold information your program can use and change.
            </p>
          </div>

          <!-- Explanation Card -->
          <div class="card card-dark" style="margin-bottom: var(--sp-6);">
            <div style="display: flex; align-items: center; gap: var(--sp-2); margin-bottom: var(--sp-4);">
              <div style="width: 24px; height: 24px; background: var(--primary); border-radius: var(--r-md); display: flex; align-items: center; justify-content: center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
              </div>
              <span style="font-size: 0.875rem; font-weight: 600; color: var(--text-inverse);">Example</span>
            </div>
            <div style="background: #0D1117; border-radius: var(--r-lg); padding: var(--sp-4); font-family: var(--font-mono); font-size: 0.875rem; line-height: 1.8; margin-bottom: var(--sp-4); border: 1px solid #21262D;">
              <div><span class="code-keyword">let</span> <span class="code-variable">name</span> <span class="code-operator">=</span> <span class="code-string">"Helix"</span>;</div>
              <div><span class="code-keyword">let</span> <span class="code-variable">age</span> <span class="code-operator">=</span> <span class="code-number">28</span>;</div>
            </div>
            <button class="btn" style="display: flex; align-items: center; gap: var(--sp-2); padding: var(--sp-3); background: rgba(99,102,241,0.08); border: 1px solid rgba(99,102,241,0.2); border-radius: var(--r-md); color: var(--text-inverse); width: 100%; justify-content: flex-start;" onclick="runExample()">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              <span style="font-size: 0.875rem; font-weight: 500;">Run Example</span>
            </button>
          </div>

          <!-- Instructional Visual -->
          <div class="card card-dark" style="margin-bottom: var(--sp-6); padding: var(--sp-6);">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-6); align-items: center;">
              <div>
                <div style="font-size: 0.875rem; font-weight: 600; color: var(--text-inverse); margin-bottom: var(--sp-3);">Visual Model</div>
                <p style="font-size: 0.875rem; color: var(--text-inverse-secondary); line-height: 1.6; margin-bottom: var(--sp-4);">
                  Each variable has a <strong style="color: var(--text-inverse);">name</strong> (the label) and a <strong style="color: var(--text-inverse);">value</strong> (what's inside). When you use <code style="background: #0D1117; padding: 2px 6px; border-radius: 4px; font-size: 0.8125rem; color: var(--primary);">let</code>, you're creating a new labeled box.
                </p>
                <div style="display: flex; gap: var(--sp-3);">
                  <div style="background: #0D1117; border: 1px solid #21262D; border-radius: var(--r-md); padding: var(--sp-3); flex: 1;">
                    <div style="font-size: 0.6875rem; color: var(--text-muted); margin-bottom: 4px;">name</div>
                    <div style="font-family: var(--font-mono); font-size: 0.875rem; color: #A5D6FF;">"Helix"</div>
                  </div>
                  <div style="background: #0D1117; border: 1px solid #21262D; border-radius: var(--r-md); padding: var(--sp-3); flex: 1;">
                    <div style="font-size: 0.6875rem; color: var(--text-muted); margin-bottom: 4px;">age</div>
                    <div style="font-family: var(--font-mono); font-size: 0.875rem; color: #79C0FF;">28</div>
                  </div>
                </div>
              </div>
              <div style="display: flex; justify-content: center;">
                <svg width="200" height="180" viewBox="0 0 200 180" fill="none" role="img" aria-label="Variable memory diagram">
                  <rect x="20" y="40" width="70" height="90" rx="8" fill="#1E293B" stroke="#6366F1" stroke-width="2"/>
                  <rect x="20" y="40" width="70" height="24" rx="8" fill="#6366F1"/>
                  <text x="55" y="57" text-anchor="middle" fill="white" font-size="11" font-weight="600" font-family="Inter">name</text>
                  <text x="55" y="95" text-anchor="middle" fill="#A5D6FF" font-size="13" font-family="JetBrains Mono">"Helix"</text>
                  
                  <rect x="110" y="40" width="70" height="90" rx="8" fill="#1E293B" stroke="#8B5CF6" stroke-width="2"/>
                  <rect x="110" y="40" width="70" height="24" rx="8" fill="#8B5CF6"/>
                  <text x="145" y="57" text-anchor="middle" fill="white" font-size="11" font-weight="600" font-family="Inter">age</text>
                  <text x="145" y="95" text-anchor="middle" fill="#79C0FF" font-size="13" font-family="JetBrains Mono">28</text>
                  
                  <path d="M55 140 L55 155 L145 155 L145 140" stroke="#475569" stroke-width="1.5" stroke-dasharray="4 4"/>
                  <text x="100" y="172" text-anchor="middle" fill="#94A3B8" font-size="10" font-family="Inter">Memory Space</text>
                </svg>
              </div>
            </div>
          </div>

          <!-- Prediction Panel -->
          <div class="card card-dark" style="margin-bottom: var(--sp-6);" id="prediction-card">
            <div style="display: flex; align-items: center; gap: var(--sp-2); margin-bottom: var(--sp-4);">
              <div style="width: 24px; height: 24px; background: var(--warning); border-radius: var(--r-md); display: flex; align-items: center; justify-content: center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              </div>
              <span style="font-size: 0.875rem; font-weight: 600; color: var(--text-inverse);">Try it — Predict the output</span>
            </div>
            <p style="font-size: 0.9375rem; color: var(--text-inverse); margin-bottom: var(--sp-2); line-height: 1.5;">
              What will this code print to the console?
            </p>
            <div style="background: #0D1117; border-radius: var(--r-md); padding: var(--sp-3); font-family: var(--font-mono); font-size: 0.875rem; margin-bottom: var(--sp-4); border: 1px solid #21262D; color: #E6EDF3;">
              <div><span class="code-keyword">let</span> <span class="code-variable">x</span> <span class="code-operator">=</span> <span class="code-number">5</span>;</div>
              <div><span class="code-variable">x</span> <span class="code-operator">=</span> <span class="code-variable">x</span> <span class="code-operator">+</span> <span class="code-number">3</span>;</div>
              <div><span class="code-function">console</span>.<span class="code-function">log</span>(<span class="code-variable">x</span>);</div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3);" id="prediction-options" role="radiogroup" aria-label="Prediction options">
              <div class="prediction-option" data-value="5" onclick="selectPrediction(this)" role="radio" aria-checked="false" tabindex="0">
                <div class="prediction-radio" aria-hidden="true"></div>
                <span>5</span>
              </div>
              <div class="prediction-option" data-value="8" onclick="selectPrediction(this)" role="radio" aria-checked="false" tabindex="0">
                <div class="prediction-radio" aria-hidden="true"></div>
                <span>8</span>
              </div>
              <div class="prediction-option" data-value="3" onclick="selectPrediction(this)" role="radio" aria-checked="false" tabindex="0">
                <div class="prediction-radio" aria-hidden="true"></div>
                <span>3</span>
              </div>
              <div class="prediction-option" data-value="x + 3" onclick="selectPrediction(this)" role="radio" aria-checked="false" tabindex="0">
                <div class="prediction-radio" aria-hidden="true"></div>
                <span>"x + 3"</span>
              </div>
            </div>
            <div style="display: flex; justify-content: flex-end; margin-top: var(--sp-4);">
              <button class="btn btn-primary" id="submit-prediction" onclick="submitPrediction()" disabled style="opacity: 0.5;" aria-label="Submit prediction">
                Submit Prediction
              </button>
            </div>
            <div id="prediction-feedback" style="margin-top: var(--sp-4); display: none;"></div>
          </div>

          <!-- Code Editor -->
          <div class="code-editor" style="margin-bottom: var(--sp-6);">
            <div class="code-header">
              <div class="code-tab">
                <span class="dot"></span>
                script.js
              </div>
              <div class="code-actions">
                <button class="btn btn-ghost btn-sm" style="color: var(--text-inverse-secondary);" onclick="resetCode()" aria-label="Reset code">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                  Reset
                </button>
                <button class="btn btn-primary btn-sm" id="run-code-btn" onclick="runCode()" aria-label="Run code">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                  Run Code
                </button>
              </div>
            </div>
            <div class="code-body" id="code-editor-body" contenteditable="true" spellcheck="false" role="textbox" aria-label="Code editor" aria-multiline="true">
              <div class="code-line"><span class="code-line-num">1</span><span class="code-comment">// Create a variable for your name</span></div>
              <div class="code-line"><span class="code-line-num">2</span><span class="code-keyword">let</span> <span class="code-variable">name</span> <span class="code-operator">=</span> <span class="code-string">"Alex"</span>;</div>
              <div class="code-line"><span class="code-line-num">3</span></div>
              <div class="code-line"><span class="code-line-num">4</span><span class="code-comment">// Create a variable for your age</span></div>
              <div class="code-line"><span class="code-line-num">5</span><span class="code-keyword">let</span> <span class="code-variable">age</span> <span class="code-operator">=</span> <span class="code-number">21</span>;</div>
              <div class="code-line"><span class="code-line-num">6</span></div>
              <div class="code-line"><span class="code-line-num">7</span><span class="code-comment">// Create a variable for your city</span></div>
              <div class="code-line"><span class="code-line-num">8</span><span class="code-keyword">let</span> <span class="code-variable">city</span> <span class="code-operator">=</span> <span class="code-string">"San Francisco"</span>;</div>
              <div class="code-line"><span class="code-line-num">9</span></div>
              <div class="code-line"><span class="code-line-num">10</span><span class="code-function">console</span>.<span class="code-function">log</span>(<span class="code-variable">name</span>, <span class="code-variable">age</span>, <span class="code-variable">city</span>);</div>
            </div>
          </div>

          <!-- Output Panel -->
          <div class="output-panel" style="margin-bottom: var(--sp-6);">
            <div class="output-header">
              <button class="output-tab active" data-tab="output" onclick="switchOutputTab(this)">Output</button>
              <button class="output-tab" data-tab="console" onclick="switchOutputTab(this)">Console</button>
              <button class="output-tab" data-tab="tests" onclick="switchOutputTab(this)">Test Results</button>
              <div style="margin-left: auto; display: flex; align-items: center; gap: var(--sp-2);">
                <div id="run-status" style="display: none; align-items: center; gap: 6px; font-size: 0.75rem; color: var(--success);">
                  <div class="spinner spinner-sm" style="border-top-color: var(--success); border-color: rgba(16,185,129,0.2);"></div>
                  Running...
                </div>
              </div>
            </div>
            <div class="output-body" id="output-body">
              <span style="color: var(--text-muted);">// Click "Run Code" to see output</span>
            </div>
          </div>

          <!-- Feedback Area -->
          <div id="lesson-feedback" style="margin-bottom: var(--sp-6); display: none;"></div>

          <!-- Navigation -->
          <div style="display: flex; justify-content: space-between; align-items: center; padding-top: var(--sp-4); border-top: 1px solid var(--border-dark); flex-wrap: wrap; gap: var(--sp-3);">
            <button class="btn btn-dark" onclick="navigateTo('dashboard')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
              Previous
            </button>
            <div style="display: flex; align-items: center; gap: var(--sp-2); font-size: 0.8125rem; color: var(--text-inverse-secondary);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Auto-saved
            </div>
            <button class="btn btn-primary" id="btn-next-practice" onclick="goToPersonalizedPractice()">
              Next Practice
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
          </div>
        </div>

        <!-- Lesson Sidebar: Tutor -->
        <div class="lesson-sidebar">
          <div class="tutor-card" id="tutor-card">
            <div class="tutor-header" style="display: flex; align-items: center; justify-content: space-between;">
              <div style="display: flex; align-items: center; gap: var(--sp-2);">
                <div class="tutor-avatar" aria-hidden="true">H</div>
                <div>
                  <div class="tutor-name">Helix Assistant</div>
                  <span class="tutor-badge">AI TUTOR</span>
                </div>
              </div>
              <button id="main-gemini-key-btn" onclick="toggleMainApiKeyModal()" title="Configure Gemini API Key" style="font-size: 0.75rem; color: var(--text-inverse-secondary); background: rgba(255,255,255,0.06); border: 1px solid var(--border-dark); border-radius: var(--r-full); padding: 2px 8px; cursor: pointer; display: flex; align-items: center; gap: 4px;">
                <span id="main-key-dot" style="width: 6px; height: 6px; border-radius: 50%; background: #94A3B8;"></span>
                <span>Gemini</span>
              </button>
            </div>
            <div id="main-tutor-pill" style="display: none; margin: var(--sp-2) 0; padding: 6px 10px; border-radius: var(--r-md); background: rgba(99,102,241,0.18); border: 1px solid rgba(99,102,241,0.4); font-size: 0.75rem; color: #818CF8;">
              <div id="main-pill-title" style="font-weight: 600;">🎯 Personalized Path Active</div>
              <div id="main-pill-desc" style="font-size: 0.6875rem; color: var(--text-inverse-secondary); margin-top: 2px;"></div>
            </div>
            <div class="tutor-message" id="tutor-message" style="max-height: 180px; overflow-y: auto; padding-right: 4px; line-height: 1.5; font-size: 0.8125rem;">
              Great job! Ask me any questions about variables or paste your code query.
            </div>
            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: var(--sp-2);">
              <button type="button" class="btn btn-dark btn-sm" style="font-size: 0.6875rem; padding: 2px 8px;" onclick="mainTutorAsk('Explain this concept in simple terms')">💡 Explain</button>
              <button type="button" class="btn btn-dark btn-sm" style="font-size: 0.6875rem; padding: 2px 8px;" onclick="mainTutorAsk('Why is my code wrong or what can be improved?')">🔍 Debug</button>
              <button type="button" class="btn btn-dark btn-sm" style="font-size: 0.6875rem; padding: 2px 8px;" onclick="mainTutorAsk('Show me an advanced example with swapping or destructuring')">⚡ Advanced</button>
            </div>
            <div style="display: flex; gap: 6px; align-items: center;">
              <input id="main-tutor-input" type="text" placeholder="Ask about this lesson..." style="flex: 1; min-width: 0; background: var(--bg-dark); border: 1px solid var(--border-dark); border-radius: var(--r-md); padding: 6px 10px; font-size: 0.8125rem; color: var(--text-inverse); outline: none;" onkeydown="if(event.key==='Enter') mainTutorSend()">
              <button class="btn btn-primary btn-sm" style="padding: 6px 10px;" onclick="mainTutorSend()" aria-label="Send">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
            </div>
          </div>

          <!-- Learning Signals -->
          <div class="card card-dark" style="margin-top: var(--sp-4); padding: var(--sp-4);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--sp-3);">
              <div style="font-size: 0.8125rem; font-weight: 600; color: var(--text-inverse);">Learning Signals</div>
              <button aria-label="Close learning signals" style="background: none; border: none; color: var(--text-muted); cursor: pointer;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
            <div style="display: flex; flex-direction: column; gap: 10px; font-size: 0.8125rem;">
              <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-inverse-secondary);">Edits</span><span style="color: var(--text-inverse); font-weight: 600;" id="signal-edits">0</span></div>
              <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-inverse-secondary);">Runs</span><span style="color: var(--text-inverse); font-weight: 600;" id="signal-runs">0</span></div>
              <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-inverse-secondary);">Errors</span><span style="color: var(--error); font-weight: 600;" id="signal-errors">0</span></div>
              <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-inverse-secondary);">Hints Used</span><span style="color: var(--text-inverse); font-weight: 600;" id="signal-hints">0</span></div>
              <div style="display: flex; justify-content: space-between;"><span style="color: var(--text-inverse-secondary);">Time Spent</span><span style="color: var(--text-inverse); font-weight: 600;" id="time-spent">00:00</span></div>
            </div>
            <div class="divider-dark"></div>
            <button class="card-action" style="font-size: 0.8125rem;" onclick="navigateTo('analytics')">View Details →</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================
         VIEW: ANALYTICS
         ============================================================ -->
    <div class="view" id="view-analytics" style="background: var(--bg-dark); min-height: calc(100vh - 64px);">
      <div class="page" style="max-width: 1400px;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--sp-6); flex-wrap: wrap; gap: var(--sp-3);">
          <div>
            <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--text-inverse); letter-spacing: -0.02em;">Your Learning Insights</h1>
            <p style="font-size: 0.9375rem; color: var(--text-inverse-secondary); margin-top: 4px;">Data that helps you learn better</p>
          </div>
          <div style="display: flex; gap: var(--sp-3); position: relative;">
            <button class="btn btn-dark btn-sm" id="timeframe-btn" onclick="toggleTimeframeDropdown()">
              <span id="timeframe-label">This Week</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div id="timeframe-dropdown" class="popover-card" style="width: 160px; right: 120px; padding: 4px;">
              <div class="search-result-item" onclick="setTimeframe('This Week')">This Week</div>
              <div class="search-result-item" onclick="setTimeframe('Last Week')">Last Week</div>
              <div class="search-result-item" onclick="setTimeframe('All Time')">All Time</div>
            </div>
            <button class="btn btn-primary btn-sm" onclick="exportAnalyticsData()">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Export Data
            </button>
          </div>
        </div>

        <!-- Stats Row -->
        <div class="grid-5" style="margin-bottom: var(--sp-6);">
          <div class="stat-card">
            <div class="stat-label">Total Time</div>
            <div class="stat-value">8h 42m</div>
            <div class="stat-change positive">↑ 12% vs last week</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Code Runs</div>
            <div class="stat-value">48</div>
            <div class="stat-change positive">↑ 18% vs last week</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Problems Solved</div>
            <div class="stat-value">14</div>
            <div class="stat-change positive">↑ 27% vs last week</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Accuracy</div>
            <div class="stat-value">78%</div>
            <div class="stat-change positive">↑ 6% vs last week</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Current Streak</div>
            <div class="stat-value">🔥 7 days</div>
            <div class="stat-change positive">Keep it up!</div>
          </div>
        </div>

        <!-- Charts Row -->
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--sp-5); margin-bottom: var(--sp-5);">
          <div class="card card-dark">
            <div class="card-title card-title-dark" style="margin-bottom: var(--sp-5);">Activity Over Time</div>
            <div style="position: relative; height: 200px;">
              <svg width="100%" height="100%" viewBox="0 0 600 200" preserveAspectRatio="none" role="img" aria-label="Activity chart">
                <line x1="40" y1="50" x2="580" y2="50" stroke="#1E293B" stroke-width="1"/>
                <line x1="40" y1="100" x2="580" y2="100" stroke="#1E293B" stroke-width="1"/>
                <line x1="40" y1="150" x2="580" y2="150" stroke="#1E293B" stroke-width="1"/>
                
                <text x="10" y="15" fill="#64748B" font-size="10" font-family="Inter">3h</text>
                <text x="10" y="65" fill="#64748B" font-size="10" font-family="Inter">2h</text>
                <text x="10" y="115" fill="#64748B" font-size="10" font-family="Inter">1h</text>
                <text x="10" y="165" fill="#64748B" font-size="10" font-family="Inter">0m</text>
                
                <path d="M 40 140 L 120 100 L 200 120 L 280 60 L 360 80 L 440 40 L 520 70 L 560 50 L 560 180 L 40 180 Z" fill="url(#areaGrad)" opacity="0.3"/>
                <path d="M 40 140 L 120 100 L 200 120 L 280 60 L 360 80 L 440 40 L 520 70 L 560 50" fill="none" stroke="#6366F1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                
                <circle cx="40" cy="140" r="4" fill="#6366F1"/>
                <circle cx="120" cy="100" r="4" fill="#6366F1"/>
                <circle cx="200" cy="120" r="4" fill="#6366F1"/>
                <circle cx="280" cy="60" r="4" fill="#6366F1"/>
                <circle cx="360" cy="80" r="4" fill="#6366F1"/>
                <circle cx="440" cy="40" r="4" fill="#6366F1"/>
                <circle cx="520" cy="70" r="4" fill="#6366F1"/>
                <circle cx="560" cy="50" r="4" fill="#6366F1"/>
                
                <text x="40" y="195" fill="#64748B" font-size="10" font-family="Inter" text-anchor="middle">Mon</text>
                <text x="120" y="195" fill="#64748B" font-size="10" font-family="Inter" text-anchor="middle">Tue</text>
                <text x="200" y="195" fill="#64748B" font-size="10" font-family="Inter" text-anchor="middle">Wed</text>
                <text x="280" y="195" fill="#64748B" font-size="10" font-family="Inter" text-anchor="middle">Thu</text>
                <text x="360" y="195" fill="#64748B" font-size="10" font-family="Inter" text-anchor="middle">Fri</text>
                <text x="440" y="195" fill="#64748B" font-size="10" font-family="Inter" text-anchor="middle">Sat</text>
                <text x="520" y="195" fill="#64748B" font-size="10" font-family="Inter" text-anchor="middle">Sun</text>
                
                <defs>
                  <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#6366F1" stop-opacity="0.4"/>
                    <stop offset="100%" stop-color="#6366F1" stop-opacity="0"/>
                  </linearGradient>
                </defs>
              </svg>
            </div>
          </div>

          <div class="card card-dark">
            <div class="card-title card-title-dark" style="margin-bottom: var(--sp-5);">Concept Mastery</div>
            <div style="display: flex; flex-direction: column; gap: 14px;">
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 6px;">
                  <span style="color: var(--text-inverse);">Variables</span>
                  <span style="color: var(--success); font-weight: 600;">85%</span>
                </div>
                <div class="progress-track progress-track-dark"><div class="progress-fill progress-fill-success" style="width: 85%;"></div></div>
              </div>
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 6px;">
                  <span style="color: var(--text-inverse);">Conditionals</span>
                  <span style="color: var(--primary); font-weight: 600;">70%</span>
                </div>
                <div class="progress-track progress-track-dark"><div class="progress-fill" style="width: 70%;"></div></div>
              </div>
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 6px;">
                  <span style="color: var(--text-inverse);">Loops</span>
                  <span style="color: var(--warning); font-weight: 600;">60%</span>
                </div>
                <div class="progress-track progress-track-dark"><div class="progress-fill" style="width: 60%; background: var(--warning);"></div></div>
              </div>
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 6px;">
                  <span style="color: var(--text-inverse);">Functions</span>
                  <span style="color: var(--warning); font-weight: 600;">45%</span>
                </div>
                <div class="progress-track progress-track-dark"><div class="progress-fill" style="width: 45%; background: var(--warning);"></div></div>
              </div>
              <div>
                <div style="display: flex; justify-content: space-between; font-size: 0.8125rem; margin-bottom: 6px;">
                  <span style="color: var(--text-inverse);">Arrays</span>
                  <span style="color: var(--error); font-weight: 600;">30%</span>
                </div>
                <div class="progress-track progress-track-dark"><div class="progress-fill" style="width: 30%; background: var(--error);"></div></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Row -->
        <div class="grid-3">
          <div class="card card-dark">
            <div class="card-title card-title-dark" style="margin-bottom: 4px;">Error Patterns</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: var(--sp-4);">Most common this week</div>
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <div style="display: flex; align-items: center; justify-content: space-between;">
                <div>
                  <div style="font-size: 0.8125rem; color: var(--text-inverse);">Syntax Error</div>
                  <div style="font-size: 0.6875rem; color: var(--text-muted);">Missing semicolon</div>
                </div>
                <div style="text-align: right;">
                  <div style="font-size: 0.8125rem; font-weight: 600; color: var(--text-inverse);">12 <span style="color: var(--text-muted); font-weight: 400;">(30%)</span></div>
                  <div class="progress-track progress-track-dark" style="width: 80px; margin-top: 4px;"><div class="progress-fill" style="width: 30%; background: var(--error);"></div></div>
                </div>
              </div>
              <div style="display: flex; align-items: center; justify-content: space-between;">
                <div>
                  <div style="font-size: 0.8125rem; color: var(--text-inverse);">Reference Error</div>
                  <div style="font-size: 0.6875rem; color: var(--text-muted);">Undefined variable</div>
                </div>
                <div style="text-align: right;">
                  <div style="font-size: 0.8125rem; font-weight: 600; color: var(--text-inverse);">8 <span style="color: var(--text-muted); font-weight: 400;">(20%)</span></div>
                  <div class="progress-track progress-track-dark" style="width: 80px; margin-top: 4px;"><div class="progress-fill" style="width: 20%; background: var(--warning);"></div></div>
                </div>
              </div>
              <div style="display: flex; align-items: center; justify-content: space-between;">
                <div>
                  <div style="font-size: 0.8125rem; color: var(--text-inverse);">Type Error</div>
                  <div style="font-size: 0.6875rem; color: var(--text-muted);">Wrong type operation</div>
                </div>
                <div style="text-align: right;">
                  <div style="font-size: 0.8125rem; font-weight: 600; color: var(--text-inverse);">6 <span style="color: var(--text-muted); font-weight: 400;">(15%)</span></div>
                  <div class="progress-track progress-track-dark" style="width: 80px; margin-top: 4px;"><div class="progress-fill" style="width: 15%; background: var(--warning);"></div></div>
                </div>
              </div>
            </div>
            <div style="margin-top: var(--sp-4); padding-top: var(--sp-4); border-top: 1px solid var(--border-dark); display: flex; align-items: center; justify-content: center;">
              <div style="width: 80px; height: 80px; border-radius: var(--r-full); border: 8px solid var(--border-dark); border-top-color: var(--error); border-right-color: var(--warning); border-bottom-color: var(--warning); position: relative; display: flex; align-items: center; justify-content: center;">
                <div style="text-align: center;">
                  <div style="font-size: 1.25rem; font-weight: 700; color: var(--text-inverse);">31</div>
                  <div style="font-size: 0.625rem; color: var(--text-muted);">Total Errors</div>
                </div>
              </div>
            </div>
          </div>

          <div class="card card-dark">
            <div class="card-title card-title-dark" style="margin-bottom: 4px;">Hint Usage</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: var(--sp-4);">By lesson</div>
            <div style="display: flex; align-items: flex-end; gap: 8px; height: 120px; padding-top: var(--sp-4);">
              <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px;">
                <div style="width: 100%; background: var(--primary); border-radius: 4px 4px 0 0; height: 20%;"></div>
                <span style="font-size: 0.625rem; color: var(--text-muted);">L1</span>
              </div>
              <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px;">
                <div style="width: 100%; background: var(--primary); border-radius: 4px 4px 0 0; height: 40%;"></div>
                <span style="font-size: 0.625rem; color: var(--text-muted);">L2</span>
              </div>
              <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px;">
                <div style="width: 100%; background: var(--primary); border-radius: 4px 4px 0 0; height: 30%;"></div>
                <span style="font-size: 0.625rem; color: var(--text-muted);">L3</span>
              </div>
              <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px;">
                <div style="width: 100%; background: var(--primary); border-radius: 4px 4px 0 0; height: 60%;"></div>
                <span style="font-size: 0.625rem; color: var(--text-muted);">L4</span>
              </div>
              <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px;">
                <div style="width: 100%; background: var(--primary); border-radius: 4px 4px 0 0; height: 45%;"></div>
