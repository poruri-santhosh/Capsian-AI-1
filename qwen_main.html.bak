<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Helix — Adaptive Coding Learning</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.0.16/index.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.0.18/index.css">
<style>
/* ============================================================
   HELIX DESIGN TOKENS — PHASE 1 REFINED
   Production-ready: no CDN framework dependencies
   ============================================================ */
:root {
  /* Colors — Light */
  --bg-primary: #F8FAFC;
  --bg-secondary: #F1F5F9;
  --bg-tertiary: #E2E8F0;
  --surface: #FFFFFF;
  --surface-hover: #FAFBFD;
  --elevated: #FFFFFF;

  /* Colors — Dark */
  --bg-dark: #0B1121;
  --bg-dark-secondary: #0F172A;
  --bg-dark-tertiary: #151D2E;
  --surface-dark: #151D2E;
  --surface-dark-hover: #1E293B;
  --elevated-dark: #1E293B;

  /* Borders */
  --border: #E2E8F0;
  --border-subtle: #F1F5F9;
  --border-strong: #CBD5E1;
  --border-dark: #1E293B;
  --border-dark-subtle: #334155;

  /* Accent */
  --primary: #6366F1;
  --primary-hover: #4F46E5;
  --primary-light: #EEF2FF;
  --primary-dark-light: #E0E7FF;
  --secondary: #8B5CF6;
  --secondary-light: #F5F3FF;

  /* Semantic */
  --success: #10B981;
  --success-light: #D1FAE5;
  --success-dark: #065F46;
  --warning: #F59E0B;
  --warning-light: #FEF3C7;
  --warning-dark: #92400E;
  --error: #EF4444;
  --error-light: #FEE2E2;
  --error-dark: #991B1B;
  --info: #3B82F6;
  --info-light: #DBEAFE;

  /* Text */
  --text-primary: #0F172A;
  --text-secondary: #475569;
  --text-muted: #94A3B8;
  --text-faint: #CBD5E1;
  --text-inverse: #F1F5F9;
  --text-inverse-secondary: #94A3B8;

  /* Typography */
  --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', 'SF Mono', monospace;

  /* Spacing scale (4px base) */
  --sp-1: 0.25rem;
  --sp-2: 0.5rem;
  --sp-3: 0.75rem;
  --sp-4: 1rem;
  --sp-5: 1.25rem;
  --sp-6: 1.5rem;
  --sp-8: 2rem;
  --sp-10: 2.5rem;
  --sp-12: 3rem;
  --sp-16: 4rem;

  /* Radius */
  --r-sm: 0.375rem;
  --r-md: 0.5rem;
  --r-lg: 0.75rem;
  --r-xl: 1rem;
  --r-2xl: 1.25rem;
  --r-full: 9999px;

  /* Shadows */
  --shadow-xs: 0 1px 2px rgba(15,23,42,0.04);
  --shadow-sm: 0 1px 3px rgba(15,23,42,0.06), 0 1px 2px rgba(15,23,42,0.04);
  --shadow-md: 0 4px 6px -1px rgba(15,23,42,0.07), 0 2px 4px -2px rgba(15,23,42,0.04);
  --shadow-lg: 0 10px 15px -3px rgba(15,23,42,0.08), 0 4px 6px -4px rgba(15,23,42,0.04);
  --shadow-xl: 0 20px 25px -5px rgba(15,23,42,0.1), 0 8px 10px -6px rgba(15,23,42,0.06);
  --shadow-glow: 0 0 0 3px rgba(99,102,241,0.15);

  /* Motion */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.45, 0, 0.55, 1);
  --dur-micro: 150ms;
  --dur-standard: 250ms;
  --dur-major: 500ms;
  --dur-instructional: 800ms;

  /* Layout */
  --sidebar-w: 240px;
  --topbar-h: 64px;
  --content-max: 1280px;
}

[data-theme="dark"], html.dark, body.dark {
  --bg-primary: #0B1121;
  --bg-secondary: #0F172A;
  --bg-tertiary: #151D2E;
  --surface: #151D2E;
  --surface-hover: #1E293B;
  --elevated: #1E293B;
  --border: #1E293B;
  --border-subtle: #243048;
  --border-strong: #334155;
  --text-primary: #F1F5F9;
  --text-secondary: #94A3B8;
  --text-muted: #64748B;
  --text-faint: #334155;
}

.search-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  right: 0;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-lg);
  z-index: 100;
  max-height: 360px;
  overflow-y: auto;
  padding: var(--sp-2);
}
.search-result-item {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  font-size: 0.875rem;
  color: var(--text-primary);
  cursor: pointer;
  transition: background var(--dur-micro);
}
.search-result-item:hover, .search-result-item.selected {
  background: var(--bg-secondary);
}
.popover-card {
  position: absolute;
  top: calc(100% + 12px);
  right: 0;
  width: 320px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  box-shadow: var(--shadow-xl);
  padding: var(--sp-4);
  z-index: 100;
  display: none;
}
.popover-card.open {
  display: block;
}

/* ============================================================
   RESET & BASE
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-family: var(--font-sans); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
body { background: var(--bg-primary); color: var(--text-primary); line-height: 1.5; overflow-x: hidden; }
button { font-family: inherit; cursor: pointer; border: none; background: none; }
a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }
code, pre, .mono { font-family: var(--font-mono); }

/* Focus states — accessibility */
:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
  border-radius: var(--r-sm);
}
button:focus-visible, a:focus-visible, [tabindex]:focus-visible {
  outline: 2px solid var(--primary);
  outline-offset: 2px;
}

/* Scrollbar */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: var(--r-full); }
::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

/* ============================================================
   APP SHELL
   ============================================================ */
.app-shell { display: flex; min-height: 100vh; }

/* ============================================================
   SIDEBAR
   ============================================================ */
.sidebar {
  width: var(--sidebar-w);
  min-height: 100vh;
  background: var(--surface);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  transition: transform var(--dur-standard) var(--ease-out);
}
.sidebar-brand {
  padding: var(--sp-6);
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  border-bottom: 1px solid var(--border-subtle);
}
.sidebar-brand-text {
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text-primary);
}
.sidebar-nav { padding: var(--sp-4); flex: 1; overflow-y: auto; }
.sidebar-section-label {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  padding: var(--sp-4) var(--sp-3) var(--sp-2);
}
.nav-item {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-secondary);
  cursor: pointer;
  transition: all var(--dur-micro) var(--ease-out);
  margin-bottom: 2px;
  user-select: none;
  border: none;
  background: none;
  width: 100%;
  text-align: left;
}
.nav-item:hover { background: var(--bg-secondary); color: var(--text-primary); }
.nav-item.active {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}
.nav-item svg { width: 18px; height: 18px; flex-shrink: 0; color: var(--text-muted); transition: color var(--dur-micro); }
.nav-item:hover svg { color: var(--text-secondary); }
.nav-item.active svg { color: var(--primary); }
.sidebar-footer {
  padding: var(--sp-4);
  border-top: 1px solid var(--border-subtle);
}
.theme-toggle {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-size: 0.8125rem;
  color: var(--text-secondary);
  padding: var(--sp-2) var(--sp-3);
  cursor: pointer;
  border-radius: var(--r-md);
  transition: background var(--dur-micro);
  background: none;
  border: none;
  width: 100%;
  text-align: left;
}
.theme-toggle:hover { background: var(--bg-secondary); color: var(--text-primary); }

/* ============================================================
   MAIN CONTENT
   ============================================================ */
.main-content {
  margin-left: var(--sidebar-w);
  flex: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ============================================================
   TOPBAR
   ============================================================ */
.topbar {
  height: var(--topbar-h);
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  padding: 0 var(--sp-8);
  gap: var(--sp-4);
  position: sticky;
  top: 0;
  z-index: 30;
}
.search-bar {
  flex: 1;
  max-width: 480px;
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  padding: var(--sp-2) var(--sp-4);
  transition: all var(--dur-micro);
}
.search-bar:focus-within { border-color: var(--primary); box-shadow: var(--shadow-glow); background: var(--surface); }
.search-bar input {
  flex: 1;
  border: none;
  background: none;
  outline: none;
  font-size: 0.875rem;
  color: var(--text-primary);
  font-family: var(--font-sans);
}
.search-bar input::placeholder { color: var(--text-muted); }
.search-bar svg { color: var(--text-muted); width: 16px; height: 16px; flex-shrink: 0; }
.search-kbd {
  font-size: 0.6875rem;
  color: var(--text-muted);
  background: var(--surface);
  padding: 2px 6px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border);
  font-family: var(--font-sans);
  font-weight: 500;
}
.topbar-actions { display: flex; align-items: center; gap: var(--sp-3); margin-left: auto; }
.icon-btn {
  width: 36px; height: 36px;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md);
  color: var(--text-secondary);
  cursor: pointer;
  transition: all var(--dur-micro);
  position: relative;
  background: none;
  border: none;
}
.icon-btn:hover { background: var(--bg-secondary); color: var(--text-primary); }
.icon-btn .badge-dot {
  position: absolute; top: 6px; right: 6px;
  width: 8px; height: 8px;
  background: var(--error);
  border-radius: var(--r-full);
  border: 2px solid var(--surface);
}
.avatar {
  width: 36px; height: 36px;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  display: flex; align-items: center; justify-content: center;
  color: white; font-weight: 600; font-size: 0.875rem;
  cursor: pointer;
  transition: transform var(--dur-micro);
}
.avatar:hover { transform: scale(1.05); }
.mobile-menu-btn { display: none; }

/* ============================================================
   PAGE CONTAINER
   ============================================================ */
.page { padding: var(--sp-8); max-width: var(--content-max); margin: 0 auto; width: 100%; }
.page-header { margin-bottom: var(--sp-8); }
.page-title { font-size: 1.875rem; font-weight: 700; letter-spacing: -0.03em; color: var(--text-primary); line-height: 1.2; }
.page-subtitle { font-size: 1rem; color: var(--text-secondary); margin-top: var(--sp-2); }

/* ============================================================
   CARDS
   ============================================================ */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: var(--sp-6);
  transition: box-shadow var(--dur-standard) var(--ease-out), transform var(--dur-standard) var(--ease-out);
}
.card-hover:hover { box-shadow: var(--shadow-md); }
.card-dark {
  background: var(--surface-dark);
  border-color: var(--border-dark);
}
.card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--sp-5); }
.card-title { font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); }
.card-title-dark { color: var(--text-inverse); }
.card-action { font-size: 0.8125rem; color: var(--primary); font-weight: 500; cursor: pointer; background: none; border: none; }
.card-action:hover { text-decoration: underline; }

/* ============================================================
   BUTTONS
   ============================================================ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  padding: var(--sp-2) var(--sp-4);
  border-radius: var(--r-md);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--dur-micro) var(--ease-out);
  border: 1px solid transparent;
  user-select: none;
  white-space: nowrap;
  font-family: var(--font-sans);
  line-height: 1.4;
}
.btn:active { transform: scale(0.97); }
.btn-primary {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
}
.btn-primary:hover { background: var(--primary-hover); border-color: var(--primary-hover); }
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-secondary {
  background: var(--surface);
  color: var(--text-primary);
  border-color: var(--border);
}
.btn-secondary:hover { background: var(--bg-secondary); border-color: var(--border-strong); }
.btn-ghost { background: transparent; color: var(--text-secondary); }
.btn-ghost:hover { background: var(--bg-secondary); color: var(--text-primary); }
.btn-sm { padding: var(--sp-1) var(--sp-3); font-size: 0.8125rem; }
.btn-lg { padding: var(--sp-3) var(--sp-6); font-size: 0.9375rem; }
.btn-dark {
  background: var(--surface-dark);
  color: var(--text-inverse);
  border-color: var(--border-dark);
}
.btn-dark:hover { background: var(--surface-dark-hover); }

/* ============================================================
   PROGRESS BAR
   ============================================================ */
.progress-track {
  height: 6px;
  background: var(--bg-secondary);
  border-radius: var(--r-full);
  overflow: hidden;
}
.progress-track-dark { background: var(--bg-dark-tertiary); }
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  border-radius: var(--r-full);
  transition: width var(--dur-major) var(--ease-out);
}
.progress-fill-success { background: var(--success); }
.progress-fill-warning { background: var(--warning); }

/* ============================================================
   CONCEPT CARD
   ============================================================ */
.concept-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-xl);
  padding: var(--sp-5);
  cursor: pointer;
  transition: all var(--dur-standard) var(--ease-out);
}
.concept-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); border-color: var(--primary); }
.concept-icon {
  width: 40px; height: 40px;
  border-radius: var(--r-lg);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.125rem;
  margin-bottom: var(--sp-3);
}
.concept-title { font-size: 0.9375rem; font-weight: 600; color: var(--text-primary); margin-bottom: 2px; }
.concept-meta { font-size: 0.8125rem; color: var(--text-muted); }

/* ============================================================
   PREDICTION CARD
   ============================================================ */
.prediction-option {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4);
  border: 1.5px solid var(--border);
  border-radius: var(--r-lg);
  cursor: pointer;
  transition: all var(--dur-micro) var(--ease-out);
  font-size: 0.875rem;
  font-family: var(--font-mono);
  background: var(--surface);
  color: var(--text-primary);
}
.prediction-option:hover:not(.disabled) { border-color: var(--primary); background: var(--primary-light); }
.prediction-option.selected { border-color: var(--primary); background: var(--primary-light); box-shadow: var(--shadow-glow); }
.prediction-option.correct { border-color: var(--success); background: var(--success-light); }
.prediction-option.incorrect { border-color: var(--error); background: var(--error-light); }
.prediction-option.disabled { cursor: default; opacity: 0.7; }
.prediction-radio {
  width: 18px; height: 18px;
  border-radius: var(--r-full);
  border: 2px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: all var(--dur-micro);
}
.prediction-option.selected .prediction-radio { border-color: var(--primary); background: var(--primary); }
.prediction-option.selected .prediction-radio::after { content: ''; width: 6px; height: 6px; background: white; border-radius: var(--r-full); }
.prediction-option.correct .prediction-radio { border-color: var(--success); background: var(--success); }
.prediction-option.incorrect .prediction-radio { border-color: var(--error); background: var(--error); }

/* ============================================================
   CODE EDITOR
   ============================================================ */
.code-editor {
  background: #0D1117;
  border-radius: var(--r-xl);
  overflow: hidden;
  border: 1px solid #21262D;
}
.code-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-3) var(--sp-4);
  background: #161B22;
  border-bottom: 1px solid #21262D;
}
.code-tab {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  font-size: 0.8125rem;
  color: var(--text-inverse-secondary);
  padding: var(--sp-1) var(--sp-3);
  border-radius: var(--r-md);
  background: #0D1117;
  font-family: var(--font-mono);
}
.code-tab .dot { width: 8px; height: 8px; border-radius: var(--r-full); background: var(--success); }
.code-actions { display: flex; gap: var(--sp-2); }
.code-body {
  padding: var(--sp-5);
  font-family: var(--font-mono);
  font-size: 0.875rem;
  line-height: 1.7;
  color: #E6EDF3;
  overflow-x: auto;
  min-height: 160px;
  outline: none;
}
.code-line { display: flex; }
.code-line-num { color: #484F58; min-width: 2rem; text-align: right; margin-right: var(--sp-4); user-select: none; }
.code-keyword { color: #FF7B72; }
.code-string { color: #A5D6FF; }
.code-variable { color: #79C0FF; }
.code-function { color: #D2A8FF; }
.code-comment { color: #8B949E; font-style: italic; }
.code-number { color: #79C0FF; }
.code-operator { color: #FF7B72; }

/* ============================================================
   OUTPUT PANEL
   ============================================================ */
.output-panel {
  background: #0D1117;
  border: 1px solid #21262D;
  border-radius: var(--r-xl);
  overflow: hidden;
}
.output-header {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-3) var(--sp-4);
  background: #161B22;
  border-bottom: 1px solid #21262D;
  font-size: 0.8125rem;
}
.output-tab {
  color: var(--text-inverse-secondary);
  cursor: pointer;
  padding-bottom: 2px;
  border-bottom: 2px solid transparent;
  transition: all var(--dur-micro);
  background: none;
  border-top: none;
  border-left: none;
  border-right: none;
  font-size: 0.8125rem;
  font-family: var(--font-sans);
}
.output-tab:hover { color: var(--text-inverse); }
.output-tab.active { color: var(--text-inverse); border-bottom-color: var(--primary); }
.output-body {
  padding: var(--sp-4);
  font-family: var(--font-mono);
  font-size: 0.875rem;
  color: var(--success);
  min-height: 60px;
}

/* ============================================================
   FEEDBACK CARD
   ============================================================ */
.feedback-card {
  border-radius: var(--r-lg);
  padding: var(--sp-4);
  display: flex;
  gap: var(--sp-3);
  align-items: flex-start;
  animation: feedbackSlide 0.3s var(--ease-out);
}
@keyframes feedbackSlide {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}
.feedback-success { background: var(--success-light); border: 1px solid #A7F3D0; }
.feedback-error { background: var(--error-light); border: 1px solid #FECACA; }
.feedback-hint { background: var(--info-light); border: 1px solid #BFDBFE; }
.feedback-icon { width: 20px; height: 20px; flex-shrink: 0; margin-top: 1px; }
.feedback-text { font-size: 0.875rem; color: var(--text-primary); line-height: 1.5; }
.feedback-text strong { font-weight: 600; }
.feedback-text code {
  background: rgba(15,23,42,0.08);
  padding: 1px 5px;
  border-radius: 4px;
  font-family: var(--font-mono);
  font-size: 0.8125rem;
}

/* ============================================================
   TUTOR CARD
   ============================================================ */
.tutor-card {
  background: var(--surface-dark);
  border: 1px solid var(--border-dark);
  border-radius: var(--r-xl);
  padding: var(--sp-5);
}
.tutor-header { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-4); }
.tutor-avatar {
  width: 32px; height: 32px;
  border-radius: var(--r-full);
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  display: flex; align-items: center; justify-content: center;
  font-size: 0.75rem; color: white; font-weight: 700;
}
.tutor-name { font-size: 0.875rem; font-weight: 600; color: var(--text-inverse); }
.tutor-badge { font-size: 0.6875rem; background: var(--primary); color: white; padding: 1px 6px; border-radius: var(--r-full); font-weight: 600; margin-left: 6px; }
.tutor-message { font-size: 0.875rem; color: var(--text-inverse-secondary); line-height: 1.6; margin-bottom: var(--sp-4); }
.tutor-message strong { color: var(--text-inverse); }
.tutor-message code {
  background: #0D1117;
  padding: 1px 4px;
  border-radius: 3px;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--primary);
}
.tutor-actions { display: flex; flex-direction: column; gap: var(--sp-2); }

/* ============================================================
   LEARNING PATH
   ============================================================ */
.path-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex: 1;
}
.path-circle {
  width: 48px; height: 48px;
  border-radius: var(--r-full);
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 1rem;
  position: relative;
  z-index: 2;
  transition: all var(--dur-standard);
}
.path-circle.completed { background: var(--success); color: white; }
.path-circle.current { background: var(--primary); color: white; box-shadow: 0 0 0 4px rgba(99,102,241,0.2); }
.path-circle.locked { background: var(--bg-secondary); color: var(--text-muted); border: 2px dashed var(--border); }
.path-connector {
  position: absolute;
  top: 24px;
  left: 50%;
  width: 100%;
  height: 2px;
  background: var(--border);
  z-index: 1;
}
.path-connector.completed { background: var(--success); }
.path-connector.current { background: linear-gradient(90deg, var(--success), var(--primary)); }
.path-label { margin-top: var(--sp-3); font-size: 0.8125rem; font-weight: 500; color: var(--text-primary); text-align: center; }
.path-meta { font-size: 0.75rem; color: var(--text-muted); margin-top: 2px; }

/* ============================================================
   STATS
   ============================================================ */
.stat-card {
  background: var(--surface-dark);
  border: 1px solid var(--border-dark);
  border-radius: var(--r-xl);
  padding: var(--sp-5);
}
.stat-label { font-size: 0.8125rem; color: var(--text-inverse-secondary); margin-bottom: var(--sp-2); }
.stat-value { font-size: 1.75rem; font-weight: 700; color: var(--text-inverse); letter-spacing: -0.02em; }
.stat-change { font-size: 0.75rem; margin-top: var(--sp-2); display: flex; align-items: center; gap: 4px; }
.stat-change.positive { color: var(--success); }
.stat-change.negative { color: var(--error); }

/* ============================================================
   BADGE
   ============================================================ */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px;
  border-radius: var(--r-full);
  font-size: 0.75rem;
  font-weight: 500;
}
.badge-primary { background: var(--primary-light); color: var(--primary); }
.badge-success { background: var(--success-light); color: var(--success-dark); }
.badge-warning { background: var(--warning-light); color: var(--warning-dark); }
.badge-error { background: var(--error-light); color: var(--error-dark); }
.badge-muted { background: var(--bg-secondary); color: var(--text-muted); }

/* ============================================================
   LOADING / SKELETON
   ============================================================ */
.skeleton {
  background: linear-gradient(90deg, var(--bg-secondary) 25%, var(--border-subtle) 50%, var(--bg-secondary) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--r-md);
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
.spinner {
  width: 20px; height: 20px;
  border: 2px solid var(--border);
  border-top-color: var(--primary);
  border-radius: var(--r-full);
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.spinner-sm { width: 14px; height: 14px; border-width: 1.5px; }

/* ============================================================
   EMPTY STATE
   ============================================================ */
.empty-state { text-align: center; padding: var(--sp-12) var(--sp-8); }
.empty-state svg { margin-bottom: var(--sp-6); }
.empty-state-title { font-size: 1.125rem; font-weight: 600; color: var(--text-primary); margin-bottom: var(--sp-2); }
.empty-state-text { font-size: 0.875rem; color: var(--text-secondary); max-width: 320px; margin: 0 auto var(--sp-6); line-height: 1.6; }

/* ============================================================
   TABS
   ============================================================ */
.tabs { display: flex; gap: var(--sp-1); border-bottom: 1px solid var(--border); margin-bottom: var(--sp-6); }
.tab {
  padding: var(--sp-3) var(--sp-4);
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-secondary);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: all var(--dur-micro);
  margin-bottom: -1px;
  background: none;
  border-top: none;
  border-left: none;
  border-right: none;
  font-family: var(--font-sans);
}
.tab:hover { color: var(--text-primary); }
.tab.active { color: var(--primary); border-bottom-color: var(--primary); font-weight: 600; }

/* ============================================================
   VIEW TRANSITIONS
   ============================================================ */
.view { display: none; }
.view.active { display: block; animation: viewFade 0.4s var(--ease-out); }
@keyframes viewFade {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============================================================
   LESSON LAYOUT
   ============================================================ */
.lesson-layout {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: var(--sp-6);
  max-width: 1400px;
  margin: 0 auto;
  padding: var(--sp-6) var(--sp-8);
}
.lesson-main { min-width: 0; }
.lesson-sidebar { position: sticky; top: 80px; height: fit-content; }

/* ============================================================
   BREADCRUMB
   ============================================================ */
.breadcrumb { display: flex; align-items: center; gap: var(--sp-2); font-size: 0.8125rem; color: var(--text-muted); margin-bottom: var(--sp-4); }
.breadcrumb a { color: var(--text-secondary); }
.breadcrumb a:hover { color: var(--primary); }
.breadcrumb-sep { color: var(--text-muted); }

/* ============================================================
   DIVIDER
   ============================================================ */
.divider { height: 1px; background: var(--border); margin: var(--sp-4) 0; }
.divider-dark { height: 1px; background: var(--border-dark); margin: var(--sp-4) 0; }

/* ============================================================
   TEXT GRADIENT
   ============================================================ */
.text-gradient {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ============================================================
   FLOATING ELEMENTS (subtle)
   ============================================================ */
.float-el {
  background: var(--surface);
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border);
}

/* ============================================================
   EVENT INSPECTOR (dev-only)
   ============================================================ */
.event-inspector {
  position: fixed;
  bottom: var(--sp-4);
  right: var(--sp-4);
  width: 420px;
  max-height: 480px;
  background: #0D1117;
  border: 1px solid #21262D;
  border-radius: var(--r-xl);
  box-shadow: var(--shadow-xl);
  z-index: 100;
  display: none;
  flex-direction: column;
  overflow: hidden;
  font-family: var(--font-mono);
  font-size: 0.75rem;
}
.event-inspector.open { display: flex; }
.event-inspector-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-3) var(--sp-4);
  background: #161B22;
  border-bottom: 1px solid #21262D;
}
.event-inspector-title {
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--text-inverse);
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}
.event-inspector-title .dot {
  width: 8px; height: 8px;
  background: var(--success);
  border-radius: var(--r-full);
  animation: pulse 2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.event-inspector-body {
  flex: 1;
  overflow-y: auto;
  padding: var(--sp-3);
}
.event-item {
  padding: var(--sp-2) var(--sp-3);
  border-radius: var(--r-md);
  margin-bottom: 4px;
  background: #161B22;
  border: 1px solid #21262D;
  transition: background var(--dur-micro);
}
.event-item:hover { background: #1E293B; }
.event-item-time { color: var(--text-muted); font-size: 0.6875rem; }
.event-item-type {
  color: var(--primary);
  font-weight: 600;
  font-size: 0.75rem;
  margin: 2px 0;
}
.event-item-meta { color: var(--text-inverse-secondary); font-size: 0.6875rem; }
.event-item-payload { color: var(--text-muted); font-size: 0.6875rem; margin-top: 2px; word-break: break-all; }
.event-inspector-footer {
  padding: var(--sp-3) var(--sp-4);
  background: #161B22;
  border-top: 1px solid #21262D;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.6875rem;
  color: var(--text-muted);
}
.event-inspector-toggle {
  position: fixed;
  bottom: var(--sp-4);
  right: var(--sp-4);
  width: 40px; height: 40px;
  border-radius: var(--r-full);
  background: var(--primary);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: var(--shadow-lg);
  z-index: 99;
  border: none;
  transition: transform var(--dur-micro);
}
.event-inspector-toggle:hover { transform: scale(1.05); }

/* ============================================================
   MOBILE
   ============================================================ */
@media (max-width: 1024px) {
  .sidebar { transform: translateX(-100%); }
  .sidebar.open { transform: translateX(0); box-shadow: var(--shadow-xl); }
  .main-content { margin-left: 0; }
  .mobile-menu-btn { display: flex; }
  .lesson-layout { grid-template-columns: 1fr; }
  .lesson-sidebar { position: static; }
  .event-inspector { width: calc(100% - var(--sp-8)); right: var(--sp-4); left: var(--sp-4); }
}
@media (max-width: 768px) {
  .page { padding: var(--sp-4); }
  .topbar { padding: 0 var(--sp-4); }
  .search-bar { display: none; }
  .lesson-layout { padding: var(--sp-4); }
}

/* ============================================================
   REDUCED MOTION
   ============================================================ */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  .view.active { animation: none; }
}

/* ============================================================
   UTILITY
   ============================================================ */
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-col { flex-direction: column; }
.gap-2 { gap: var(--sp-2); }
.gap-3 { gap: var(--sp-3); }
.gap-4 { gap: var(--sp-4); }
.gap-6 { gap: var(--sp-6); }
.mt-2 { margin-top: var(--sp-2); }
.mt-4 { margin-top: var(--sp-4); }
.mb-4 { margin-bottom: var(--sp-4); }
.mb-6 { margin-bottom: var(--sp-6); }
.text-sm { font-size: 0.875rem; }
.text-xs { font-size: 0.75rem; }
.text-muted { color: var(--text-muted); }
.text-secondary { color: var(--text-secondary); }
.text-primary-c { color: var(--text-primary); }
.text-inverse-c { color: var(--text-inverse); }
.font-semibold { font-weight: 600; }
.font-mono { font-family: var(--font-mono); }
.w-full { width: 100%; }
.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
.grid-5 { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--sp-4); }
</style>
</head>
<body>

<div class="app-shell">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar" role="navigation" aria-label="Main navigation">
    <div class="sidebar-brand">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <circle cx="14" cy="14" r="12" fill="url(#brandGrad)"/>
        <path d="M9 14C9 11.5 11 9.5 14 9.5C17 9.5 19 11.5 19 14C19 16.5 17 18.5 14 18.5" stroke="white" stroke-width="2" stroke-linecap="round"/>
        <path d="M11 14C11 12.5 12.5 11 14 11C15.5 11 17 12.5 17 14" stroke="white" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
        <defs><linearGradient id="brandGrad" x1="0" y1="0" x2="28" y2="28"><stop stop-color="#6366F1"/><stop offset="1" stop-color="#8B5CF6"/></linearGradient></defs>
      </svg>
      <span class="sidebar-brand-text">Helix</span>
    </div>

    <nav class="sidebar-nav">
      <div class="sidebar-section-label">Learn</div>
      <a href="qwen_main.html" class="nav-item active" data-view="dashboard" aria-current="page">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
      </a>
      <a href="qwen_learn.html" class="nav-item" data-view="learn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        Learn
      </a>
      <a href="qwen_practice.html" class="nav-item" data-view="lesson">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Practice
      </a>
      <button class="nav-item" data-view="path" onclick="navigateTo('path')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        Projects
      </button>
      <button class="nav-item" data-view="sandbox" onclick="navigateTo('sandbox')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        Sandbox
      </button>

      <div class="sidebar-section-label">Insights</div>
      <button class="nav-item" data-view="analytics" onclick="navigateTo('analytics')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        Analytics
      </button>
      <button class="nav-item" data-view="community" onclick="navigateTo('community')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Community
      </button>

      <div class="sidebar-section-label">Account</div>
      <button class="nav-item" data-view="profile" onclick="navigateTo('profile')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Profile
      </button>
      <button class="nav-item" data-view="settings" onclick="navigateTo('settings')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Settings
      </button>
    </nav>

    <div class="sidebar-footer">
      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        Theme
      </button>
    </div>
  </aside>

  <!-- MAIN CONTENT -->
  <div class="main-content">

    <!-- TOPBAR -->
    <header class="topbar" role="banner">
      <button class="icon-btn mobile-menu-btn" onclick="toggleSidebar()" aria-label="Toggle menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div class="search-bar" role="search" style="position: relative;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="topbar-search-input" placeholder="Search concepts, courses, or code..." aria-label="Search" oninput="handleGlobalSearch(this.value)" onkeydown="handleSearchKeydown(event)" autocomplete="off">
        <span class="search-kbd">K</span>
        <div id="search-results-dropdown" class="search-dropdown" style="display: none;"></div>
      </div>
      <div class="topbar-actions" style="position: relative;">
        <button class="icon-btn" id="streak-btn" style="color: var(--warning);" aria-label="Streak: 12 days" onclick="toggleStreakPopover()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
          <span style="font-size: 0.75rem; font-weight: 600; margin-left: 2px;" id="topbar-streak-count">12</span>
        </button>
        <div id="streak-popover" class="popover-card">
          <div style="font-weight: 700; font-size: 0.9375rem; display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
            <span>🔥</span> 12-Day Streak!
          </div>
          <p style="font-size: 0.8125rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 12px;">
            You're on a roll! Practice or complete a lesson today to reach 13 days.
          </p>
          <button class="btn btn-primary btn-sm w-full" style="width: 100%;" onclick="navigateTo('lesson'); closePopovers();">Continue Lesson</button>
        </div>

        <button class="icon-btn" id="notification-btn" aria-label="Notifications" onclick="toggleNotificationPopover()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="badge-dot" id="notif-dot" aria-hidden="true"></span>
        </button>
        <div id="notification-popover" class="popover-card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <span style="font-weight: 700; font-size: 0.9375rem;">Notifications</span>
